{
  "schemaVersion": 1,
  "id": "russet",
  "version": "${version}",
  "name": "Russet",
  "description": "Quality of life and better graphics for Minecraft: Fabulous graphics with effect particles, weather particles, cave dust and dynamic lights, an attack indicator that shows more than your attack, every video setting in one place with other graphics mods' settings, the Russet Pack of resource packs (fetched from Modrinth) and a loading screen of its own. On Apple silicon Macs it draws the game through Metal, from a modified copy of mcopt by Noah Dunnagan. NOT AN OFFICIAL MINECRAFT PRODUCT. NOT APPROVED BY OR ASSOCIATED WITH MOJANG OR MICROSOFT.",
  "authors": ["Lackothy"],
  "contributors": ["Noah Dunnagan (mcopt, Apache-2.0)", "Gael Quintanilla and contributors (Metal Shaders, Apache-2.0)", "FlashyReese (Reese's Sodium Options, MIT)", "pigcart (Particle Rain, MIT)", "Minenash (Enhanced Attack Indicator, MIT)"],
  "contact": { "sources": "https://github.com/Lackothy/Orchard", "issues": "https://github.com/Lackothy/Orchard/issues" },
  "license": "PolyForm-Shield-1.0.0",
  "icon": "assets/russet/pack.png",
  "environment": "client",
  "entrypoints": {
    "preLaunch": ["com.lackothy.russet.video.sodium.SodiumConfigApi", "mcopt.metal.Preload"],
    "client": ["com.lackothy.RussetClient"]
  },
  "mixins": [
    "russet.mixins.json",
    "mcopt-metal.mixins.json",
    "mcopt-metal-lod.mixins.json",
    "mcopt-metal-gen.mixins.json",
    "mcopt-metal-own.mixins.json",
    "mcopt-metal-ownmesh.mixins.json",
    "mcopt-metal-startup.mixins.json",
    "mcopt-metal-qos.mixins.json",
    "mcopt-metal-cpu.mixins.json",
    "mcopt-metal-chunk.mixins.json",
    "mcopt-metal-alloc.mixins.json",
    "mcopt-metal-chunkio.mixins.json",
    "mcopt-metal-edge.mixins.json",
    "mcopt-metal-compat.mixins.json",
    "mcopt-metal-shade.mixins.json",
    "mcopt-metal-shade-shadow.mixins.json",
    "mcopt-metal-shade-vl.mixins.json",
    "mcopt-metal-shade-light.mixins.json",
    "mcopt-metal-shade-dims.mixins.json",
    "russet-rain.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=25",
    "fabric-api": "*"
  },
  "breaks": {
    "orchard": "*",
    "orchard_metal": "*"
  }
}
